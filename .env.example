# Variaveis de ambiente do webhook de automacao de DM do Instagram.
# Copie para .env.local e preencha com valores reais (nunca commitar valores reais).

# Token arbitrario definido por voce, usado na verificacao do webhook (GET /api/webhook/instagram).
# Deve ser identico ao "Verify Token" configurado no painel do app Meta ao cadastrar o webhook.
META_WEBHOOK_VERIFY_TOKEN=

# App Secret do app no Meta for Developers (Configuracoes do app > Basico).
# Usado para validar a assinatura HMAC SHA-256 (header x-hub-signature-256) de cada chamada do webhook.
META_APP_SECRET=

# Access token com escopo instagram_business_basic + instagram_business_manage_comments
# (Instagram API with Instagram Login) -- ou, se autenticado via Facebook Login com uma Pagina,
# instagram_basic + instagram_manage_comments + pages_read_engagement. Usado pra chamar a Graph API
# (enviar private reply / DM via POST /{IG_BUSINESS_ACCOUNT_ID}/messages e responder comentarios
# publicamente via POST /{comment-id}/replies).
META_PAGE_ACCESS_TOKEN=

# ID da conta comercial do Instagram (Instagram Business Account) conectada ao app.
# Usado como {ig-business-account-id} no endpoint de private reply (POST /{id}/messages)
# e como guarda anti-loop pra ignorar comentarios feitos pela propria conta.
IG_BUSINESS_ACCOUNT_ID=

# Senha unica de acesso ao painel admin (/automations, /contacts, /activity), verificada via
# Basic Auth pelo middleware.ts. Uso interno de agencia, um admin so -- sem sistema de usuarios.
ADMIN_PASSWORD=
